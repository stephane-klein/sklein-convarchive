# sklein-convarchive local configuration
# Copy to .sklein-convarchive.toml and adjust values.

# Identity attributed to human/user messages of AI conversation exports
# (claude-chatgpt-backup-extension-export). Global setting, also available as
# the SKLEIN_CONVARCHIVE_OWNER environment variable or the --owner flag.
owner = "stephane"

# Timezone used for timestamps in the JSONL/Markdown render and for day/month
# boundaries (IANA name). Global setting, also available as the
# SKLEIN_CONVARCHIVE_TIMEZONE environment variable or the --timezone flag.
timezone = "Europe/Paris"

[mattermost]
server_url = "https://mattermost.example.com"
# token = ""
# username = ""
# password = ""
# mfa_token = ""

[s3]
endpoint = "http://localhost:9000"
access_key = "rustfsadmin"
secret_key = "rustfsadmin"
bucket = "conversations"

# Optional age encryption (public key only, generate with: age-keygen)
[age]
# recipient = "age1..."
# encrypt = true
# identity = "/path/to/age.key"   # age private key (file path or AGE-SECRET-KEY-1... content), required by `storage browse` to read encrypted (.age) objects
